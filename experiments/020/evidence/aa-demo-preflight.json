  "task_id": "aa4ec2a5",
  "code": "def transform(grid):\n    H = len(grid)\n    W = len(grid[0])\n    g = [row[:] for row in grid]\n    out = [row[:] for row in grid]\n\n    def inb(r, c):\n        return 0 <= r < H and 0 <= c < W\n\n    comps = []\n    for r in range(H):\n        for c in range(W):\n            if g[r][c] == 1:\n                stack = [(r, c)]\n                g[r][c] = 0\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if inb(nx, ny) and g[nx][ny] == 1:\n                            g[nx][ny] = 0\n                            stack.append((nx, ny))\n                comps.append(cells)\n\n    for cells in comps:\n        if not cells:\n            continue\n        s = set(cells)\n        holes = []\n        seen_hole = set()\n        for r, c in s:\n            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n                if inb(nr, nc) and grid[nr][nc] == 4 and (nr, nc) not in seen_hole:\n                    stack = [(nr, nc)]\n                    seen_hole.add((nr, nc))\n                    comp_bg = []\n                    closed = True\n                    while stack:\n                        x, y = stack.pop()\n                        comp_bg.append((x, y))\n                        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n                            if not inb(nx, ny):\n                                closed = False\n                                continue\n                            if (nx, ny) in seen_hole or grid[nx][ny] != 4:\n                                continue\n                            seen_hole.add((nx, ny))\n                            stack.append((nx, ny))\n                    if closed:\n                        holes.extend(comp_bg)\n        hole_set = set(holes)\n        interior = s | hole_set\n        for r, c in s:\n            out[r][c] = 8 if hole_set else 1\n        for r, c in holes:\n            out[r][c] = 6\n        border = set()\n        for r, c in interior:\n            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n                if inb(nr, nc) and (nr, nc) not in interior and out[nr][nc] == 4:\n                    border.add((nr, nc))\n        for r, c in border:\n            out[r][c] = 2\n    return out",
